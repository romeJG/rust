# Compiled files
/target/

# Dependency directory for some setups
**/Cargo.lock

# Ignore Cargo.lock only for libraries
# (If it's a binary project like your CLI, you SHOULD commit Cargo.lock)

# Backup & temp files
**/*.rs.bk
**/*.swp
**/*.swo
**/*.tmp

# IDE files
.idea/
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Byproducts of running `cargo doc`
/doc/

# Old build artifacts (rare cases)
/target-old/
